# Environment configuration for QuickBite Internal Monorepo
NODE_ENV=development
PORT=3000

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quickbite?schema=public"

# Redis & Queue (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT & Authentication
JWT_SECRET=quickbite-internal-super-secret-key-change-in-prod
JWT_EXPIRES_IN=7d
